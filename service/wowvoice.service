[Unit]
Description=wowvoice: sleeps until Battle.net/WoW starts; then hold R4, speak, release -> text into WoW chat (~/wowvoice)
After=pipewire.service wireplumber.service
Wants=pipewire.service

[Service]
Type=simple
WorkingDirectory=%h/wowvoice
ExecStart=%h/wowvoice/envs/sherpa/bin/python -u %h/wowvoice/service/sleeper.py
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5
StandardOutput=append:%h/wowvoice/.cache/service.log
StandardError=append:%h/wowvoice/.cache/service.log

[Install]
WantedBy=default.target
