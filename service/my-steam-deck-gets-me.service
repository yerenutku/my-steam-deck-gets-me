[Unit]
Description=wowvoice: sleeps until Battle.net/WoW starts; then hold R4, speak, release -> text into WoW chat (~/my-steam-deck-gets-me)
After=pipewire.service wireplumber.service
Wants=pipewire.service

[Service]
Type=simple
WorkingDirectory=%h/my-steam-deck-gets-me
ExecStart=%h/my-steam-deck-gets-me/envs/sherpa/bin/python -u %h/my-steam-deck-gets-me/service/sleeper.py
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5
StandardOutput=append:%h/my-steam-deck-gets-me/.cache/service.log
StandardError=append:%h/my-steam-deck-gets-me/.cache/service.log

[Install]
WantedBy=default.target
